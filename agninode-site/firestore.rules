rules_version = '2';
service cloud.firestore { match /databases/{db}/documents {
  function role() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role; }
  match /devices/{id} {
    allow read: if request.auth != null;
    allow create: if role() in ['admin','device'] || request.auth != null;
    allow update: if request.auth != null;
    allow delete: if role() == 'admin';
    match /telemetry/{t} { allow read: if request.auth != null; allow create: if role() == 'device'; }
    match /readings/{r} { allow read: if request.auth != null; allow create, update: if role() in ['device', 'admin'] || request.auth != null; }
    match /status/{s} { allow read: if request.auth != null; allow write: if role() in ['device', 'admin'] || request.auth != null; }
    match /{allSubcollections=**} { allow read: if request.auth != null; }
  }
  match /config/{d} { allow read: if request.auth != null; allow write: if role() == 'admin'; }
  match /users/{u} { allow read: if request.auth.uid == u || role() == 'admin'; allow update: if role() == 'admin'; }
} }
